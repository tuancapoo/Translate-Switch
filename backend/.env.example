# Copy file này thành .env (đã gitignore) để chạy local.
# Trên Netlify: Site configuration > Environment variables, thêm đúng các tên dưới đây.

# Chuỗi bí mật tự đặt; Switch gửi kèm header x-app-token
APP_TOKEN=

# Priority 1: endpoint chuẩn OpenAI (/v1/chat/completions)
ROUTER_BASE_URL=
ROUTER_API_KEY=
ROUTER_MODEL=

# Priority 2 và 3: Gemini (dùng chung một key)
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3-flash-preview

# Priority 4: Claude (tuỳ chọn). Mặc định claude-opus-5-5; đổi sang model nhanh/rẻ hơn nếu muốn
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Priority 5: ChatGPT / OpenAI (tuỳ chọn). Mặc định gpt-6-luna
OPENAI_API_KEY=
OPENAI_MODEL=

# Thời gian tối đa (ms) cho mỗi provider và cho cả chuỗi fallback
PROVIDER_TIMEOUT_MS=12000
TOTAL_TIMEOUT_MS=25000
