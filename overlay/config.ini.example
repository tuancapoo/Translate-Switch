# Chép file này lên thẻ SD thành: /config/translate/config.ini
# (file thật chứa token, KHÔNG commit lên git)

# Endpoint backend
url=https://translate-nx.netlify.app/api/translate

# Phải trùng với APP_TOKEN cấu hình trên Netlify
token=

# Ngôn ngữ đích (gửi lên server qua header x-target-lang)
lang=Vietnamese

# Provider và API key của riêng bạn (tuỳ chọn).
# Có api_key thì overlay gửi kèm request và server dùng đúng key này, không dùng key của server.
# Bỏ trống api_key thì server dùng cấu hình sẵn của nó.
# Hiện hỗ trợ provider: gemini. model bỏ trống = model mặc định của provider.
provider=gemini
api_key=
model=

# Độ đậm nền box bản dịch, 0-100 (0 = trong suốt hoàn toàn, 100 = đặc). Đổi được trong overlay: Cài đặt > Nền box.
box_opacity=70

# Phím tắt chụp & dịch (2-4 nút). Đổi được ngay trong overlay: Cài đặt > Phím tắt.
# Tên nút: L R ZL ZR SL SR A B X Y DUP DDOWN DLEFT DRIGHT LS RS PLUS MINUS
hotkey=L+R+ZR
